import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from datetime import datetime
import os

df = pd.read_csv('data.csv/raw_weather.csv')
print(df.head())
print(df.info())
print(df.describe())


df = df[['Temperature', 'Humidity', 'Rain']].dropna()

df = df.rename(columns={
    'Temperature': 'temperature',
    'Humidity': 'humidity',
    'Rain': 'rain_label' 
})

import os
os.makedirs('data', exist_ok=True)
df.to_csv('data/cleaned_weather.csv', index=False)

print(f"Cleaned data shape: {df.shape}")


daily_mean = np.mean(df['temperature'])
daily_std = np.std(df['temperature'])
print(f"Daily Temp - Mean: {daily_mean:.2f}, Std: {daily_std:.2f}, Min: {np.min(df['temperature'])}, Max: {np.max(df['temperature'])}")


plt.style.use('default')
os.makedirs('images', exist_ok=True) 

plt.figure(figsize=(8, 4))
plt.plot(df.index, df['temperature'])
plt.title('Temperature Trend (by row index)')
plt.xlabel('Data point index')
plt.ylabel('Temperature (°C)')
plt.tight_layout()
plt.savefig('images/temp_line.png', dpi=300, bbox_inches='tight')
plt.show()


import matplotlib.pyplot as plt


rain_counts = df['rain_label'].value_counts()
print(rain_counts)

plt.figure(figsize=(6, 4))
plt.bar(rain_counts.index, rain_counts.values, color=['blue', 'orange'])
plt.title('Count of Rain vs No Rain')
plt.xlabel('Rain label')
plt.ylabel('Number of records')
plt.tight_layout()
plt.savefig('images/rain_bar.png', dpi=300, bbox_inches='tight')
plt.show()

plt.subplot(2, 2, 3)
plt.scatter(df['temperature'], df['humidity'], alpha=0.6)
plt.title('Humidity vs Temperature')
plt.xlabel('Temperature (°C)')
plt.ylabel('Humidity (%)')
plt.savefig('images/humidity_scatter.png', dpi=300, bbox_inches='tight')

plt.subplot(2, 2, 4)
df = df.reset_index(drop=True)
df['day'] = df.index + 1 
plt.plot(df['day'], df['temperature'], label='Temp')
plt.plot(df['day'], df['humidity'] / 2, label='Humidity (scaled)')
plt.title('Temperature & Humidity Trends')
plt.legend()
plt.savefig('images/combined.png', dpi=300, bbox_inches='tight')
plt.tight_layout()
plt.show()

temp_by_rain = df.groupby('rain_label')['temperature'].agg(['mean', 'min', 'max', 'std'])
print("Temperature statistics by rain / no rain:")
print(temp_by_rain)


hum_by_rain = df.groupby('rain_label')['humidity'].agg(['mean', 'min', 'max', 'std'])
print("\nHumidity statistics by rain / no rain:")
print(hum_by_rain)


group_stats = df.groupby('rain_label').agg({
    'temperature': ['mean', 'min', 'max', 'std'],
    'humidity': ['mean', 'min', 'max', 'std']
})

print("\nCombined temperature and humidity stats by rain / no rain:")
print(group_stats)


import os
os.makedirs('data', exist_ok=True)
group_stats.to_csv('data/group_stats_by_rain.csv')
print("\nGroup-by stats exported to data/group_stats_by_rain.csv")

